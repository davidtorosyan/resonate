+/**
+ * Class <code>WebTrace</code> streams what the engine finds, while it works, for the in-browser
+ * progress view of PDF → Song ("the Reader").
+ * <p>
+ * Active only with system property <code>audiveris.web.trace</code>:
+ * <ul>
+ * <li><code>web</code>: each block goes to the {@link #emit} native, implemented in JavaScript
+ * (a CheerpJ native, like {@link WebOCR}'s recognizeGray)</li>
+ * <li><code>stderr</code>: each block is printed to System.err (native runs, A/B checks)</li>
+ * </ul>
+ * Otherwise (the default) the call sites skip it ({@link #ON} is false).
+ * <p>
+ * Tracing only reads. Bounds come from {@link AbstractInter#peekBounds()} (no caching), key
+ * signatures from their shape or alter signs, time signatures from their fields or numbers,
+ * ensembles' members unsorted; the note pitches after PAGE use the accessors the MusicXML export
+ * uses, after the step and before the sheet is stored. Every entry point catches Throwable, so
+ * tracing can never fail recognition; a native that fails turns tracing off.
+ * <p>
+ * Wire format: one string per call (a "block"), lines separated by '\n'. A block's first line is
+ * a header starting with an upper-case letter; record lines follow. Coordinates are sheet pixels
+ * (the input image's pixels). Texts are URI-encoded (UTF-8, as encodeURIComponent; a space is
+ * %20).
+ * <pre>
+ * K n done invalid        transcription starts: n sheets in the book; sheets already done (a
+ *                         resumed book) as a comma list or -, sheets left invalid (or -)
+ * B s STEP                STEP starts on sheet s
+ * E s STEP ms             STEP done on sheet s in ms milliseconds; record lines:
+ *   d w h                   after LOAD: the image size
+ *   i interline             after SCALE: pixels from a staff line to the next
+ * G s n                   grid of sheet s after GRID, n systems; record lines:
+ *   y sys l t r b           a system's box (left top right bottom)
+ *   f sys staff part x0 x1 yl1 yr1 ... yl5 yr5    a staff: system, staff and part ids, left and
+ *                           right abscissae, then each line's ordinate at its left and right end
+ * Y s STEP sys            symbols of system sys after STEP: sent after each system of a
+ *                         per-system step (possibly empty), and after any step for a system whose
+ *                         symbols changed since last sent; record lines:
+ *   +id k x y w h [v...]    a symbol added (its bounding box); a '+' for an id already sent
+ *                           replaces it (a slur found to be a tie)
+ *   -id                     a symbol removed
+ *   m x0 x1 ... xn          after MEASURES: the abscissae of the system's measure boundaries
+ * N s sys                 notes of system sys after PAGE, in measure then time order; records:
+ *   n chord m staff voice t dur head [head...] [lyric...]
+ *       head  = id,x,y,STEP,alter,octave[,ties]   x,y: the head's center; ties: s = a tie
+ *               starts there, e = one ends there (se: both); STEP,alter,octave = -,0,0 when
+ *               unpitched
+ *       lyric = Lverse,syllabic,text      syllabic: s single, b begin, m middle, e end
+ *   r chord m staff voice t dur x,y       a rest (x,y: its center)
+ *       m = the page measure id; t = time offset in the measure, dur = duration, both as
+ *       fractions of a whole note ("1/8"); dur "g" = grace note, "M" = whole-measure rest;
+ *       voice and t "-" when unknown
+ * S s ms                  sheet s was stored in the book file (.omr) after being processed in
+ *                         this run (also after it failed): a resume point; ms = the sheet's
+ *                         wall time, from its first step to stored
+ * F s STEP reason         sheet s failed at STEP (or ?), it is left out; reason URI-encoded
+ * </pre>
+ * Symbol kinds k and their extra values v: head (shape, staff pitch: 0 = middle line, + is
+ * down), stem, beam (median x1 y1 x2 y2, height), ledger, rest (shape), clef (shape), key
+ * (fifths), time (num/den or shape), bar (shape), slur and tie (cubic x1 y1 cx1 cy1 cx2 cy2 x2 y2),
+ * acc (shape), flag (shape), dot, word (text), lyric (text), other (shape). Ensembles (chords,
+ * sentences, lyric lines, beam groups, staff barlines), the members shown by their ensemble (key
+ * signs, time numbers) and clutter are not sent.
+ *
+ * @author Resonate web port
+ */
+public final class WebTrace
+{
+    //~ Static fields/initializers -----------------------------------------------------------------
+
+    /** System property selecting the trace output: "web" or "stderr". */
+    public static final String PROPERTY = "audiveris.web.trace";
+
+    private static final int OFF = 0;
+
+    private static final int WEB = 1;
+
+    private static final int STDERR = 2;
+
+    private static int mode = modeOf(System.getProperty(PROPERTY));
+
+    /** True when tracing was asked for: the call sites test it before calling in. */
+    public static final boolean ON = mode != OFF;
+
+    /** Sheet whose symbols are tracked. */
+    private static int sheetNumber;
+
+    /** Per system: the symbols sent (id → kind). */
+    private static final Map<SystemInfo, Map<Integer, String>> sent = new IdentityHashMap<>();
+
+    /** Key in effect (fifths) per part id and staff index in part, carried as the export does. */
+    private static final Map<String, Integer> keys = new HashMap<>();
+
+    /** Sheets processed in this run (a step started), to be reported when stored. */
+    private static final Set<Integer> touched = new HashSet<>();
+
+    /** Start time of the current step. */
+    private static long stepStart;
+
+    /** Start time of the current sheet (its first step in this run). */
+    private static long sheetStart;
+
+    //~ Constructors -------------------------------------------------------------------------------
+
+    private WebTrace ()
+    {
+    }
+
+    //~ Static Methods -----------------------------------------------------------------------------
+
+    //------//
+    // book //
+    //------//
+    /**
+     * Transcription of the book starts (right after the "Book reaching" line).
+     *
+     * @param book   the book
+     * @param target the step to reach
+     */
+    public static synchronized void book (Book book,
+                                          OmrStep target)
+    {
+        if (mode == OFF) {
+            return;
+        }
+
+        try {
+            sent.clear();
+            keys.clear();
+            touched.clear();
+            sheetNumber = 0;
+
+            final List<SheetStub> stubs = book.getStubs();
+            final StringBuilder done = new StringBuilder();
+            final StringBuilder invalid = new StringBuilder();
+
+            for (SheetStub stub : stubs) {
+                if (!stub.isValid()) {
+                    invalid.append((invalid.length() > 0) ? "," : "").append(stub.getNumber());
+                } else if (stub.isDone(target)) {
+                    done.append((done.length() > 0) ? "," : "").append(stub.getNumber());
+                }
+            }
+
+            out(new StringBuilder("K ").append(stubs.size()).append(' ').append(
+                    (done.length() > 0) ? done : "-").append(' ').append(
+                            (invalid.length() > 0) ? invalid : "-"));
+        } catch (Throwable ex) {
+            fail(ex);
+        }
+    }
+
+    //-----------//
+    // stepStart //
+    //-----------//
+    /**
+     * A step starts on a sheet (right before the step runs).
+     *
+     * @param stub the sheet stub
+     * @param step the step
+     */
+    public static synchronized void stepStart (SheetStub stub,
+                                               OmrStep step)
+    {
+        if (mode == OFF) {
+            return;
+        }
+
+        try {
+            final int s = stub.getNumber();
+
+            stepStart = System.nanoTime();
+
+            if ((s != sheetNumber) || (step == OmrStep.LOAD)) {
+                sheetNumber = s;
+                sheetStart = stepStart;
+                sent.clear();
+            }
+
+            touched.add(s);
+            out(new StringBuilder("B ").append(s).append(' ').append(step));
+        } catch (Throwable ex) {
+            fail(ex);
+        }
+    }
+
+    //------------//
+    // systemDone //
+    //------------//
+    /**
+     * A per-system step is done with a system (called right after doSystem).
+     *
+     * @param system the system just processed
+     */
+    public static synchronized void systemDone (SystemInfo system)
+    {
+        if (mode == OFF) {
+            return;
+        }
+
+        try {
+            final SheetStub stub = system.getSheet().getStub();
+            final OmrStep step = stub.getCurrentStep();
+            final StringBuilder sb = header(stub.getNumber(), step, system);
+            diff(system, sb);
+
+            if (step == OmrStep.MEASURES) {
+                measures(system, sb);
+            }
+
+            out(sb);
+        } catch (Throwable ex) {
+            fail(ex);
+        }
+    }
+
+    //----------//
+    // stepDone //
+    //----------//
+    /**
+     * A step is done on a sheet (called right after the step was marked done).
+     *
+     * @param stub the sheet stub
+     * @param step the step done
+     */
+    public static synchronized void stepDone (SheetStub stub,
+                                              OmrStep step)
+    {
+        if (mode == OFF) {
+            return;
+        }
+
+        try {
+            final long ms = (System.nanoTime() - stepStart) / 1_000_000L;
+            final int s = stub.getNumber();
+            final Sheet sheet = stub.hasSheet() ? stub.getSheet() : null;
+            final List<SystemInfo> systems = (sheet != null) ? sheet.getSystems() : null;
+
+            if ((systems != null) && !systems.isEmpty()) {
+                if (step == OmrStep.GRID) {
+                    out(grid(s, systems));
+                }
+
+                // Symbols changed by a sheet step, or by a per-system step's epilog
+                for (SystemInfo system : systems) {
+                    final StringBuilder sb = header(s, step, system);
+
+                    if (diff(system, sb)) {
+                        out(sb);
+                    }
+                }
+
+                // Systems gone: their symbols are removed
+                for (Iterator<Map.Entry<SystemInfo, Map<Integer, String>>> it = sent.entrySet()
+                        .iterator(); it.hasNext();) {
+                    final Map.Entry<SystemInfo, Map<Integer, String>> entry = it.next();
+
+                    if (!systems.contains(entry.getKey())) {
+                        final StringBuilder sb = header(s, step, entry.getKey());
+
+                        for (Integer id : entry.getValue().keySet()) {
+                            sb.append("\n-").append(id);
+                        }
+
+                        it.remove();
+                        out(sb);
+                    }
+                }
+
+                if (step == OmrStep.PAGE) {
+                    for (SystemInfo system : systems) {
+                        out(notes(s, system));
+                    }
+                }
+            }
+
+            final StringBuilder sb = new StringBuilder("E ").append(s).append(' ').append(step)
+                    .append(' ').append(ms);
+
+            if (sheet != null) {
+                if (step == OmrStep.LOAD) {
+                    sb.append("\nd ").append(sheet.getWidth()).append(' ').append(sheet
+                            .getHeight());
+                } else if (step == OmrStep.SCALE) {
+                    final Scale scale = sheet.getScale();
+
+                    if ((scale != null) && (scale.getInterline() != null)) {
+                        sb.append("\ni ").append(scale.getInterline());
+                    }
+                }
+            }
+
+            out(sb);
+        } catch (Throwable ex) {
+            fail(ex);
+        }
+    }
+
+    //-------------//
+    // sheetStored //
+    //-------------//
+    /**
+     * A sheet has been stored into the book file and released ("End of Stub#N").
+     * Reported only for a sheet processed in this run.
+     *
+     * @param stub the sheet stub
+     */
+    public static synchronized void sheetStored (SheetStub stub)
+    {
+        if (mode == OFF) {
+            return;
+        }
+
+        try {
+            final int s = stub.getNumber();
+
+            if (touched.remove(s)) {
+                final long ms = (s == sheetNumber) ? (System.nanoTime() - sheetStart) / 1_000_000L
+                        : 0;
+                out(new StringBuilder("S ").append(s).append(' ').append(ms));
+            }
+        } catch (Throwable ex) {
+            fail(ex);
+        }
+    }
+
+    //-------------//
+    // sheetFailed //
+    //-------------//
+    /**
+     * A sheet failed and is left out of the transcription.
+     *
+     * @param stub   the sheet stub
+     * @param step   the step that failed, or null
+     * @param reason the reason, as logged
+     */
+    public static synchronized void sheetFailed (SheetStub stub,
+                                                 OmrStep step,
+                                                 String reason)
+    {
+        if (mode == OFF) {
+            return;
+        }
+
+        try {
+            out(new StringBuilder("F ").append(stub.getNumber()).append(' ').append(
+                    (step != null) ? step.toString() : "?").append(' ').append(text(reason)));
+        } catch (Throwable ex) {
+            fail(ex);
+        }
+    }
+
+    //----------//
+    // boundsOf //
+    //----------//
+    /**
+     * Bounds of an inter as known, computing and caching nothing in the inter: its bounds or
+     * glyph, else its median line or curve, else its members' union.
+     */
+    private static Rectangle boundsOf (Inter inter,
+                                       int depth)
+    {
+        if (!(inter instanceof AbstractInter)) {
+            return null;
+        }
+
+        final Rectangle box = ((AbstractInter) inter).peekBounds();
+
+        if (box != null) {
+            return box;
+        }
+
+        if (inter instanceof AbstractVerticalInter) {
+            final AbstractVerticalInter v = (AbstractVerticalInter) inter;
+            final Double width = v.getWidth();
+
+            return (width != null) ? lineBox(v.getMedian(), width, true) : null;
+        }
+
+        if (inter instanceof AbstractHorizontalInter) {
+            final AbstractHorizontalInter h = (AbstractHorizontalInter) inter;
+
+            return lineBox(h.getMedian(), h.getHeight(), false);
+        }
+
+        if (inter instanceof SlurInter) {
+            final CubicCurve2D curve = ((SlurInter) inter).getCurve();
+
+            return (curve != null) ? curve.getBounds() : null;
+        }
+
+        if ((inter instanceof InterEnsemble) && (depth < 2)) {
+            Rectangle union = null;
+
+            for (Inter member : members(inter)) {
+                final Rectangle mb = boundsOf(member, depth + 1);
+
+                if (mb != null) {
+                    union = (union == null) ? mb : union.union(mb);
+                }
+            }
+
+            return union;
+        }
+
+        return null;
+    }
+
+    //------//
+    // diff //
+    //------//
+    /**
+     * Append the symbols added to / removed from the system since last sent.
+     *
+     * @return true if something was appended
+     */
+    private static boolean diff (SystemInfo system,
+                                 StringBuilder sb)
+    {
+        final SIGraph sig = system.getSig();
+
+        if (sig == null) {
+            return false;
+        }
+
+        Map<Integer, String> known = sent.get(system);
+
+        if (known == null) {
+            sent.put(system, known = new HashMap<>());
+        }
+
+        final Set<Integer> present = new HashSet<>();
+        boolean any = false;
+
+        for (Inter inter : sig.vertexSet()) {
+            if (inter.isRemoved()) {
+                continue;
+            }
+
+            final String kind = kindOf(inter);
+            final int id = inter.getId();
+
+            if ((kind == null) || (id == 0)) {
+                continue;
+            }
+
+            final String old = known.get(id);
+
+            if (old != null) {
+                present.add(id);
+
+                if (old.equals(kind)) {
+                    continue;
+                }
+            }
+
+            final String record = record(inter, id, kind);
+
+            if (record != null) { // Else bounds not known yet: try again later
+                sb.append('\n').append(record);
+                known.put(id, kind);
+                present.add(id);
+                any = true;
+            }
+        }
+
+        for (Iterator<Integer> it = known.keySet().iterator(); it.hasNext();) {
+            final Integer id = it.next();
+
+            if (!present.contains(id)) {
+                sb.append("\n-").append(id);
+                it.remove();
+                any = true;
+            }
+        }
+
+        return any;
+    }
+
+    //------//
+    // emit //
+    //------//
+    /**
+     * Implemented in JavaScript (CheerpJ native
+     * <code>Java_org_audiveris_omr_text_web_WebTrace_emit(lib, block)</code>): hand one block to
+     * the page.
+     *
+     * @param block the block
+     */
+    private static native void emit (String block);
+
+    //------//
+    // fail //
+    //------//
+    private static void fail (Throwable ex)
+    {
+        try {
+            System.err.println("WebTrace: " + ex);
+        } catch (Throwable ignored) {
+        }
+    }
+
+    //----------//
+    // fifthsOf //
+    //----------//
+    /**
+     * Key signature value, computing and caching nothing in the key: from its shape when it
+     * has one, else from its alter signs, as KeyInter.getFifths counts them.
+     */
+    private static Integer fifthsOf (KeyInter key)
+    {
+        final Shape shape = key.getShape();
+
+        if (shape != null) {
+            try {
+                return KeyInter.fifthsOf(shape);
+            } catch (Throwable ex) {
+                // Not a KEY_xxx shape: count the signs
+            }
+        }
+
+        int count = 0;
+
+        for (Inter alter : members(key)) {
+            final Shape s = alter.getShape();
+
+            if (s == Shape.SHARP) {
+                if (count < 0) {
+                    return null;
+                }
+
+                count++;
+            } else if (s == Shape.FLAT) {
+                if (count > 0) {
+                    return null;
+                }
+
+                count--;
+            } else if (s != Shape.NATURAL) {
+                return null;
+            }
+        }
+
+        return count;
+    }
+
+    //------//
+    // grid //
+    //------//
+    private static StringBuilder grid (int s,
+                                       List<SystemInfo> systems)
+    {
+        final StringBuilder sb = new StringBuilder("G ").append(s).append(' ').append(systems
+                .size());
+
+        for (SystemInfo system : systems) {
+            sb.append("\ny ").append(system.getId()).append(' ').append(system.getLeft()).append(
+                    ' ').append(system.getTop()).append(' ').append(system.getRight()).append(' ')
+                    .append(system.getBottom());
+
+            for (Staff staff : system.getStaves()) {
+                int partId = 0;
+
+                for (Part part : system.getParts()) {
+                    if (part.getStaves().contains(staff)) {
+                        partId = part.getId();
+
+                        break;
+                    }
+                }
+
+                sb.append("\nf ").append(system.getId()).append(' ').append(staff.getId()).append(
+                        ' ').append(partId).append(' ').append(staff.getAbscissa(
+                                HorizontalSide.LEFT)).append(' ').append(staff.getAbscissa(
+                                        HorizontalSide.RIGHT));
+
+                final List<LineInfo> lines = staff.getLines();
+
+                if (lines != null) {
+                    for (LineInfo line : lines) {
+                        if (line instanceof StaffLine) {
+                            final StaffLine sl = (StaffLine) line;
+                            sb.append(' ').append(Math.round(sl.getEndPoint(HorizontalSide.LEFT)
+                                    .getY())).append(' ').append(Math.round(sl.getEndPoint(
+                                            HorizontalSide.RIGHT).getY()));
+                        }
+                    }
+                }
+            }
+        }
+
+        return sb;
+    }
+
+    //--------//
+    // header //
+    //--------//
+    private static StringBuilder header (int s,
+                                         OmrStep step,
+                                         SystemInfo system)
+    {
+        return new StringBuilder("Y ").append(s).append(' ').append(step).append(' ').append(
+                system.getId());
+    }
+
+    //--------//
+    // kindOf //
+    //--------//
+    /**
+     * Report the kind sent for this inter, or null for an inter not sent.
+     */
+    private static String kindOf (Inter inter)
+    {
+        if ((inter instanceof AbstractChordInter) || (inter instanceof SentenceInter)
+                || (inter instanceof BeamGroupInter) || (inter instanceof StaffBarlineInter)
+                || (inter instanceof KeyAlterInter) || (inter instanceof TimeNumberInter)
+                || (inter instanceof ClutterInter)) {
+            return null;
+        }
+
+        if (inter instanceof HeadInter) {
+            return "head";
+        }
+
+        if ((inter instanceof RestInter) || (inter instanceof MultipleRestInter)) {
+            return "rest";
+        }
+
+        if (inter instanceof StemInter) {
+            return "stem";
+        }
+
+        if (inter instanceof AbstractBeamInter) {
+            return "beam";
+        }
+
+        if (inter instanceof LedgerInter) {
+            return "ledger";
+        }
+
+        if (inter instanceof ClefInter) {
+            return "clef";
+        }
+
+        if (inter instanceof KeyInter) {
+            return "key";
+        }
+
+        if (inter instanceof AbstractTimeInter) {
+            return "time";
+        }
+
+        if ((inter instanceof BarlineInter) || (inter instanceof BarConnectorInter)) {
+            return "bar";
+        }
+
+        if (inter instanceof SlurInter) {
+            return ((SlurInter) inter).isTie() ? "tie" : "slur";
+        }
+
+        if (inter instanceof AlterInter) {
+            return "acc";
+        }
+
+        if (inter instanceof AbstractFlagInter) {
+            return "flag";
+        }
+
+        if (inter instanceof AugmentationDotInter) {
+            return "dot";
+        }
+
+        if (inter instanceof LyricItemInter) {
+            return "lyric";
+        }
+
+        if (inter instanceof WordInter) {
+            return "word";
+        }
+
+        return "other";
+    }
+
+    //---------//
+    // lineBox //
+    //---------//
+    private static Rectangle lineBox (Line2D median,
+                                      double thickness,
+                                      boolean vertical)
+    {
+        if (median == null) {
+            return null;
+        }
+
+        double x1 = Math.min(median.getX1(), median.getX2());
+        double x2 = Math.max(median.getX1(), median.getX2());
+        double y1 = Math.min(median.getY1(), median.getY2());
+        double y2 = Math.max(median.getY1(), median.getY2());
+        final double half = thickness / 2;
+
+        if (vertical) {
+            x1 -= half;
+            x2 += half;
+        } else {
+            y1 -= half;
+            y2 += half;
+        }
+
+        final int x = (int) Math.floor(x1);
+        final int y = (int) Math.floor(y1);
+
+        return new Rectangle(x, y, (int) Math.ceil(x2) - x, (int) Math.ceil(y2) - y);
+    }
+
+    //----------//
+    // measures //
+    //----------//
+    private static void measures (SystemInfo system,
+                                  StringBuilder sb)
+    {
+        final List<MeasureStack> stacks = system.getStacks();
+
+        if ((stacks == null) || stacks.isEmpty()) {
+            return;
+        }
+
+        sb.append("\nm");
+
+        for (MeasureStack stack : stacks) {
+            sb.append(' ').append(stack.getLeft());
+        }
+
+        sb.append(' ').append(stacks.get(stacks.size() - 1).getRight());
+    }
+
+    //---------//
+    // members //
+    //---------//
+    /** An ensemble's members, unsorted (sorting would compute and cache their bounds). */
+    private static List<Inter> members (Inter ensemble)
+    {
+        return EnsembleHelper.getMembers((InterEnsemble) ensemble, null);
+    }
+
+    //--------//
+    // modeOf //
+    //--------//
+    private static int modeOf (String value)
+    {
+        if ("web".equalsIgnoreCase(value)) {
+            return WEB;
+        }
+
+        if ("stderr".equalsIgnoreCase(value)) {
+            return STDERR;
+        }
+
+        return OFF;
+    }
+
+    //----------//
+    // noteLine //
+    //----------//
+    private static void noteLine (StringBuilder sb,
+                                  AbstractChordInter chord,
+                                  String m,
+                                  Part part,
+                                  List<LyricItemInter> items,
+                                  List<OctaveShiftInter> shifts)
+    {
+        final List<AbstractNoteInter> notes = new ArrayList<>();
+
+        for (Inter member : members(chord)) {
+            if (member instanceof AbstractNoteInter) {
+                notes.add((AbstractNoteInter) member);
+            }
+        }
+
+        if (notes.isEmpty()) {
+            return;
+        }
+
+        // Bottom up, as the chord reports its notes
+        notes.sort( (n1, n2) -> Integer.compare(yOf(n2), yOf(n1)));
+
+        final AbstractNoteInter firstNote = notes.get(0);
+        final Staff staff = firstNote.getStaff();
+        final boolean rest = firstNote.getShape().isRest();
+        final Voice voice = chord.getVoice();
+        final Rational t = chord.getTimeOffset();
+        final String dur;
+
+        if (rest && chord.isMeasureRest()) {
+            dur = "M";
+        } else if (!rest && firstNote.getShape().isSmallHead()) {
+            dur = "g";
+        } else {
+            final Rational d = chord.getDuration();
+            dur = (d != null) ? fraction(d) : "-";
+        }
+
+        sb.append('\n').append(rest ? 'r' : 'n').append(' ').append(chord.getId()).append(' ')
+                .append(m).append(' ').append((staff != null) ? staff.getId() : 0).append(' ')
+                .append((voice != null) ? Integer.toString(voice.getId()) : "-").append(' ')
+                .append((t != null) ? fraction(t) : "-").append(' ').append(dur);
+
+        if (rest) {
+            final Rectangle box = firstNote.peekBounds();
+
+            if (box != null) {
+                sb.append(' ').append(box.x + (box.width / 2)).append(',').append(box.y
+                        + (box.height / 2));
+            }
+
+            return;
+        }
+
+        final Integer fifths = (staff != null) ? keys.get(part.getId() + ":" + staff
+                .getIndexInPart()) : null;
+        final int shift = octaveShift(chord, staff, shifts);
+
+        for (AbstractNoteInter note : notes) {
+            final Rectangle box = note.peekBounds();
+            sb.append(' ').append(note.getId()).append(',');
+
+            if (box != null) {
+                sb.append(box.x + (box.width / 2)).append(',').append(box.y + (box.height / 2));
+            } else {
+                sb.append("-,-");
+            }
+
+            if ((staff != null) && !staff.isOneLineStaff() && (note instanceof HeadInter)) {
+                final HeadInter head = (HeadInter) note;
+                sb.append(',').append(head.getStep()).append(',').append(head.getAlteration(
+                        fifths)).append(',').append(head.getOctave() + shift);
+                final String ties = ties(head);
+
+                if (!ties.isEmpty()) {
+                    sb.append(',').append(ties);
+                }
+            } else {
+                sb.append(",-,0,0");
+            }
+        }
+
+        if (items != null) {
+            for (LyricItemInter item : items) {
+                final LyricLineInter line = item.getLyricLine();
+                final LyricItemInter.SyllabicType syl = item.getSyllabicType();
+                final String code;
+
+                if (syl == null) {
+                    code = "s";
+                } else {
+                    code = switch (syl) {
+                        case BEGIN -> "b";
+                        case MIDDLE -> "m";
+                        case END -> "e";
+                        default -> "s";
+                    };
+                }
+
+                sb.append(" L").append((line != null) ? line.getNumber() : 0).append(',').append(
+                        code).append(',').append(text(item.getValue()));
+            }
+        }
+    }
+
+    //-------//
+    // notes //
+    //-------//
+    /**
+     * The notes of a system after PAGE: pitch as the MusicXML export computes it (the key in
+     * effect per staff, carried from system to system; the octave shift; the head's
+     * alteration), the chord's duration, time offset and voice, the lyric syllables.
+     */
+    private static StringBuilder notes (int s,
+                                        SystemInfo system)
+    {
+        final StringBuilder sb = new StringBuilder("N ").append(s).append(' ').append(system
+                .getId());
+        final SIGraph sig = system.getSig();
+
+        if (sig == null) {
+            return sb;
+        }
+
+        // Lyric syllables per chord, octave shifts
+        final Map<Inter, List<LyricItemInter>> lyrics = new IdentityHashMap<>();
+        final List<OctaveShiftInter> shifts = new ArrayList<>();
+
+        for (Inter inter : sig.vertexSet()) {
+            if (inter.isRemoved()) {
+                continue;
+            }
+
+            if (inter instanceof LyricItemInter) {
+                final LyricItemInter item = (LyricItemInter) inter;
+                final Inter chord = item.getHeadChord();
+
+                if (chord != null) {
+                    List<LyricItemInter> list = lyrics.get(chord);
+
+                    if (list == null) {
+                        lyrics.put(chord, list = new ArrayList<>());
+                    }
+
+                    list.add(item);
+                }
+            } else if (inter instanceof OctaveShiftInter) {
+                shifts.add((OctaveShiftInter) inter);
+            }
+        }
+
+        for (List<LyricItemInter> list : lyrics.values()) {
+            list.sort( (i1, i2) -> {
+                final LyricLineInter l1 = i1.getLyricLine();
+                final LyricLineInter l2 = i2.getLyricLine();
+
+                return Integer.compare((l1 != null) ? l1.getNumber() : 0, (l2 != null) ? l2
+                        .getNumber() : 0);
+            });
+        }
+
+        for (Part part : system.getParts()) {
+            final int staffCount = part.getStaves().size();
+            boolean first = true;
+
+            for (Measure measure : part.getMeasures()) {
+                // Key in effect, per staff (as PartwiseBuilder carries it)
+                if (!measure.hasKeys()) {
+                    if (first) { // No key at a system start: C
+                        for (int idx = 0; idx < staffCount; idx++) {
+                            keys.put(part.getId() + ":" + idx, 0);
+                        }
+                    }
+                } else {
+                    for (int idx = 0; idx < staffCount; idx++) {
+                        final KeyInter key = measure.getKey(idx);
+
+                        if (key != null) {
+                            final Integer fifths = fifthsOf(key);
+
+                            if (fifths != null) {
+                                keys.put(part.getId() + ":" + idx, fifths);
+                            }
+                        }
+                    }
+                }
+
+                first = false;
+
+                final List<AbstractChordInter> chords = new ArrayList<>(measure.getHeadChords());
+                chords.addAll(measure.getRestChords());
+                chords.sort( (c1, c2) -> {
+                    final Rational t1 = c1.getTimeOffset();
+                    final Rational t2 = c2.getTimeOffset();
+
+                    if ((t1 != null) && (t2 != null) && !t1.equals(t2)) {
+                        return t1.compareTo(t2);
+                    }
+
+                    if ((t1 == null) != (t2 == null)) {
+                        return (t1 == null) ? 1 : -1;
+                    }
+
+                    return Integer.compare(xOf(c1), xOf(c2));
+                });
+
+                final MeasureStack stack = measure.getStack();
+                final String m = (stack != null) ? stack.getPageId() : "-";
+
+                for (AbstractChordInter chord : chords) {
+                    try {
+                        noteLine(sb, chord, m, part, lyrics.get(chord), shifts);
+                    } catch (Throwable ex) {
+                        fail(ex);
+                    }
+                }
+            }
+        }
+
+        return sb;
+    }
+
+    //-------------//
+    // octaveShift //
+    //-------------//
+    /** Octave shift over this chord (as PartwiseBuilder.getOctaveShift). */
+    private static int octaveShift (AbstractChordInter chord,
+                                    Staff staff,
+                                    List<OctaveShiftInter> shifts)
+    {
+        if (shifts.isEmpty()) {
+            return 0;
+        }
+
+        final int x = xOf(chord);
+
+        for (OctaveShiftInter os : shifts) {
+            if (os.getStaff() == staff) {
+                final AbstractChordInter first = os.getChord(HorizontalSide.LEFT);
+                final AbstractChordInter last = os.getChord(HorizontalSide.RIGHT);
+
+                if ((first != null) && (last != null) && (x >= xOf(first)) && (x <= xOf(last))) {
+                    final Integer shift = os.getShift();
+
+                    return (shift != null) ? shift : 0;
+                }
+            }
+        }
+
+        return 0;
+    }
+
+    //-----//
+    // out //
+    //-----//
+    private static void out (StringBuilder sb)
+    {
+        final String block = sb.toString();
+
+        if (mode == WEB) {
+            try {
+                emit(block);
+            } catch (Throwable ex) {
+                mode = OFF; // No working JS side: stop tracing
+                fail(ex);
+            }
+        } else if (mode == STDERR) {
+            System.err.println(block);
+        }
+    }
+
+    //--------//
+    // record //
+    //--------//
+    /**
+     * The '+' line for an inter, or null when its bounds are not known yet.
+     */
+    private static String record (Inter inter,
+                                  int id,
+                                  String kind)
+    {
+        final Rectangle box = boundsOf(inter, 0);
+
+        if (box == null) {
+            return null;
+        }
+
+        final StringBuilder sb = new StringBuilder().append('+').append(id).append(' ').append(
+                kind).append(' ').append(box.x).append(' ').append(box.y).append(' ').append(
+                        box.width).append(' ').append(box.height);
+        final Shape shape = inter.getShape();
+
+        switch (kind) {
+            case "head" -> {
+                sb.append(' ').append(shape);
+                final Double pitch = ((HeadInter) inter).getPitch();
+
+                if (pitch != null) {
+                    sb.append(' ').append((int) Math.rint(pitch));
+                }
+            }
+
+            case "beam" -> {
+                final AbstractHorizontalInter beam = (AbstractHorizontalInter) inter;
+                final Line2D median = beam.getMedian();
+
+                if (median != null) {
+                    sb.append(' ').append(Math.round(median.getX1())).append(' ').append(Math
+                            .round(median.getY1())).append(' ').append(Math.round(median.getX2()))
+                            .append(' ').append(Math.round(median.getY2())).append(' ').append(
+                                    Math.round(beam.getHeight()));
+                }
+            }
+
+            case "key" -> {
+                final Integer fifths = fifthsOf((KeyInter) inter);
+
+                if (fifths != null) {
+                    sb.append(' ').append(fifths);
+                }
+            }
+
+            case "time" -> {
+                final String value = timeOf((AbstractTimeInter) inter);
+
+                if (value != null) {
+                    sb.append(' ').append(value);
+                } else if (shape != null) {
+                    sb.append(' ').append(shape);
+                }
+            }
+
+            case "slur", "tie" -> {
+                final CubicCurve2D c = ((SlurInter) inter).getCurve();
+
+                if (c != null) {
+                    sb.append(' ').append(Math.round(c.getX1())).append(' ').append(Math.round(c
+                            .getY1())).append(' ').append(Math.round(c.getCtrlX1())).append(' ')
+                            .append(Math.round(c.getCtrlY1())).append(' ').append(Math.round(c
+                                    .getCtrlX2())).append(' ').append(Math.round(c.getCtrlY2()))
+                            .append(' ').append(Math.round(c.getX2())).append(' ').append(Math
+                                    .round(c.getY2()));
+                }
+            }
+
+            case "word", "lyric" -> sb.append(' ').append(text(((WordInter) inter).getValue()));
+
+            case "rest", "clef", "bar", "acc", "flag", "other" -> {
+                if (shape != null) {
+                    sb.append(' ').append(shape);
+                }
+            }
+
+            default -> {
+            }
+        }
+
+        return sb.toString();
+    }
+
+    //----------//
+    // fraction //
+    //----------//
+    private static String fraction (Rational r)
+    {
+        return r.num + "/" + r.den;
+    }
+
+    //------//
+    // text //
+    //------//
+    private static String text (String value)
+    {
+        if (value == null) {
+            return "";
+        }
+
+        return URLEncoder.encode(value, StandardCharsets.UTF_8).replace("+", "%20");
+    }
+
+    //--------//
+    // timeOf //
+    //--------//
+    /**
+     * A time signature's "num/den", computing and caching nothing in it (TimePairInter and
+     * TimeCustomInter cache their value in a field that is stored with the book).
+     */
+    private static String timeOf (AbstractTimeInter time)
+    {
+        if (time instanceof TimeWholeInter) {
+            final TimeRational tr = time.getTimeRational(); // A plain field
+
+            return (tr != null) ? (tr.num + "/" + tr.den) : null;
+        }
+
+        if (time instanceof TimeCustomInter) {
+            final TimeCustomInter custom = (TimeCustomInter) time;
+
+            return custom.getNumerator() + "/" + custom.getDenominator();
+        }
+
+        if (time instanceof TimePairInter) {
+            final List<Inter> numbers = members(time);
+
+            if (numbers.size() == 2) {
+                // Numerator on top
+                numbers.sort( (n1, n2) -> Integer.compare(yOf(n1), yOf(n2)));
+                final Integer num = ((AbstractNumberInter) numbers.get(0)).getValue();
+                final Integer den = ((AbstractNumberInter) numbers.get(1)).getValue();
+
+                return ((num != null) && (den != null)) ? (num + "/" + den) : null;
+            }
+        }
+
+        return null;
+    }
+
+    //------//
+    // ties //
+    //------//
+    /** "s" if a tie starts at this head, "e" if one ends there (both: "se"). */
+    private static String ties (HeadInter head)
+    {
+        final SIGraph sig = head.getSig();
+        String start = "";
+        String end = "";
+
+        for (Relation rel : sig.getRelations(head, SlurHeadRelation.class)) {
+            final SlurInter slur = (SlurInter) sig.getOppositeInter(head, rel);
+
+            if (slur.isTie()) {
+                if (slur.getHead(HorizontalSide.LEFT) == head) {
+                    start = "s";
+                }
+
+                if (slur.getHead(HorizontalSide.RIGHT) == head) {
+                    end = "e";
+                }
+            }
+        }
+
+        return start + end;
+    }
+
+    //-----//
+    // xOf //
+    //-----//
+    /** Center abscissa of a chord, from its notes' known bounds. */
+    private static int xOf (AbstractChordInter chord)
+    {
+        Rectangle union = null;
+
+        for (Inter note : members(chord)) {
+            final Rectangle box = boundsOf(note, 1);
+
+            if (box != null) {
+                union = (union == null) ? box : union.union(box);
+            }
+        }
+
+        return (union != null) ? (union.x + (union.width / 2)) : 0;
+    }
+
+    //-----//
+    // yOf //
+    //-----//
+    /** Center ordinate of an inter, from its known bounds. */
+    private static int yOf (Inter inter)
+    {
+        final Rectangle box = boundsOf(inter, 1);
+
+        return (box != null) ? (box.y + (box.height / 2)) : 0;
+    }
+}
