+    //--------------------//
+    // getStemHeadsLinked //
+    //--------------------//
+    /**
+     * Report the stem-related heads to link to stems in the provided sheet: the stem template
+     * notes, plus the small oval heads (with the small heads switch off, those only exist as cue
+     * partners of standard heads on their stems).
+     *
+     * @param sheet provided sheet
+     * @return the head shapes to link
+     */
+    public static EnumSet<Shape> getStemHeadsLinked (Sheet sheet)
+    {
+        final EnumSet<Shape> set = getTemplateNotesStem(sheet);
+        set.add(NOTEHEAD_BLACK_SMALL);
+        set.add(NOTEHEAD_VOID_SMALL);
+
+        return set;
+    }
+
+    //-----------------------//
+    // smallHeadsArePartners //
+    //-----------------------//
+    /**
+     * Tell whether the small heads of the provided sheet are cue partners only.
+     * <p>
+     * With the small heads switch off, small heads are not looked for as such: NoteHeadsBuilder
+     * keeps one only as the partner of a standard head on the same stem (a cue-size second voice
+     * printed on the main voice's stem). Such a head belongs to the standard chord, on its stem
+     * and beams.
+     *
+     * @param sheet the sheet at hand
+     * @return true if small heads are cue partners only
+     */
+    public static boolean smallHeadsArePartners (Sheet sheet)
+    {
+        return !sheet.getStub().getProcessingSwitches().getValue(ProcessingSwitch.smallHeads);
+    }
