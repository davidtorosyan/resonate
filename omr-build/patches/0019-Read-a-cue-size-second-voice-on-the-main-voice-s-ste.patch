+    //-------------------//
+    // selectCuePartners //
+    //-------------------//
+    /**
+     * Keep a small head found on a stem seed only as the partner of a standard head on the same
+     * seed and side, a third to a sixth away: a cue-size note printed on the main voice's stem
+     * (a second singer's part in a vocal line).
+     * <p>
+     * A small head is removed when it has no such partner, when it is weak, or when a standard head
+     * at its pitch or a step away overlaps it with a comparable grade (the small template matched
+     * inside or beside a real head). A small head kept removes the weak standard heads that overlap
+     * it: matched across the pair (a void ring whose top and bottom are the two heads, the ledger
+     * between blanked) or right on the small head.
+     *
+     * @param heads the heads created for the staff at hand
+     */
+    private void selectCuePartners (List<HeadInter> heads)
+    {
+        final int maxDp = constants.maxCuePartnerDeltaPitch.getValue();
+        final double minCueGrade = constants.minCueGrade.getValue();
+        final double ratio = constants.minInsideRatio.getValue();
+
+        for (HeadInter small : heads) {
+            if (small.isRemoved() || !small.getShape().isSmallHead()) {
+                continue;
+            }
+
+            final SeedSide ss = seedSides.get(small);
+            final int ps = small.getIntegerPitch();
+            final Rectangle box = small.getBounds();
+            HeadInter partner = null;
+            HeadInter conflict = null;
+
+            for (HeadInter head : heads) {
+                if ((head == small) || head.isRemoved() || head.getShape().isSmallHead()) {
+                    continue;
+                }
+
+                final int dp = Math.abs(head.getIntegerPitch() - ps);
+
+                if ((dp <= 1) && head.getBounds().intersects(box)
+                        && (head.getGrade() >= ratio * small.getGrade())) {
+                    conflict = head;
+                }
+
+                final SeedSide hs = seedSides.get(head);
+
+                if ((ss != null) && (hs != null) && (hs.seed == ss.seed)
+                        && (hs.anchor == ss.anchor) && (dp >= 2) && (dp <= maxDp)
+                        && (head.getGrade() >= Grades.goodInterGrade)
+                        && (isVoid(head.getShape()) == isVoid(small.getShape()))) {
+                    if ((partner == null) || (head.getGrade() > partner.getGrade())) {
+                        partner = head;
+                    }
+                }
+            }
+
+            final boolean keep = (partner != null) && (conflict == null)
+                    && (small.getGrade() >= minCueGrade);
+
+            if (small.isVip() || logger.isDebugEnabled()) {
+                logger.info("{} cue head {} partner:{} conflict:{}", keep ? "Keeping" : "Dropping",
+                        small, partner, conflict);
+            }
+
+            if (!keep) {
+                small.remove();
+                continue;
+            }
+
+            // Weak standard heads overlapping the cue head (on it or a step away), or matched
+            // across the pair (between the two heads)
+            final int pp = partner.getIntegerPitch();
+
+            for (HeadInter head : heads) {
+                if ((head == partner) || head.isRemoved() || head.getShape().isSmallHead()) {
+                    continue;
+                }
+
+                final int ph = head.getIntegerPitch();
+                final boolean onCue = (Math.abs(ph - ps) <= 1) && head.getBounds().intersects(box);
+                final boolean across = ((ph - ps) * (ph - pp) < 0) && (head.getGrade() < ratio
+                        * small.getGrade()) && (head.getBounds().intersects(box) || head
+                                .getBounds().intersects(partner.getBounds()));
+
+                if (!onCue && !across) {
+                    continue;
+                }
+
+                if (head.isVip() || logger.isDebugEnabled()) {
+                    logger.info("Removing {} beside cue head {}", head, small);
+                }
+
+                head.remove();
+            }
+        }
+    }
+
