+    //-------------//
+    // measureFont //
+    //-------------//
+    /**
+     * Report the font adjusted to word value and bounds.
+     * <p>
+     * A lyrics extender line glued to a word (as in "pain_") is not text:
+     * its width would inflate the computed font size, so we measure the word without it.
+     *
+     * @param info the font info to adjust
+     * @return the adjusted font info
+     */
+    private FontInfo measureFont (FontInfo info)
+    {
+        final List<TextChar> core = getCoreChars();
+
+        if (core != null) {
+            final StringBuilder sb = new StringBuilder();
+            core.forEach(ch -> sb.append(ch.getValue()));
+
+            return info.adjustedTextFont(sb.toString(), boundsOf(core));
+        }
+
+        return info.adjustedTextFont(value, getBounds());
+    }
