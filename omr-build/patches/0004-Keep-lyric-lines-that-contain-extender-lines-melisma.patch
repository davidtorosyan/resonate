+    //------------//
+    // isDashOnly //
+    //------------//
+    /**
+     * Report whether the word is made of dash-like characters only
+     * (hyphen, low line, en dash, em dash), such as a lyrics hyphen or extender line.
+     * <p>
+     * The width of such a word is not related to any font size.
+     *
+     * @return true if dash-only
+     */
+    public boolean isDashOnly ()
+    {
+        return isDash(value);
+    }
+
+    //--------//
+    // isDash //
+    //--------//
+    /**
+     * Report whether the provided string is not empty and made of dash-like chars only.
+     *
+     * @param str the string to check
+     * @return true if so
+     */
+    public static boolean isDash (String str)
+    {
+        if ((str == null) || str.isEmpty()) {
+            return false;
+        }
+
+        for (int i = 0; i < str.length(); i++) {
+            if (DASH_CHARS.indexOf(str.charAt(i)) == -1) {
+                return false;
+            }
+        }
+
+        return true;
+    }
