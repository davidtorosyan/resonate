@@ -515,6 +548,47 @@ public class TextWord
         return subWords;
     }
 
+    //--------------//
+    // getCoreChars //
+    //--------------//
+    /**
+     * Report the word chars without any leading or trailing dash-like chars,
+     * if the word has such chars as well as other chars.
+     *
+     * @return the core chars, or null if there is nothing to strip or nothing would remain
+     */
+    private List<TextChar> getCoreChars ()
+    {
+        if (chars.isEmpty()) {
+            return null;
+        }
+
+        // Check chars are consistent with word value
+        final StringBuilder sb = new StringBuilder();
+        chars.forEach(ch -> sb.append(ch.getValue()));
+
+        if (!sb.toString().equals(value)) {
+            return null;
+        }
+
+        int first = 0;
+        int last = chars.size() - 1;
+
+        while ((first <= last) && isDash(chars.get(first).getValue())) {
+            first++;
+        }
+
+        while ((last >= first) && isDash(chars.get(last).getValue())) {
+            last--;
+        }
+
+        if ((first > last) || ((first == 0) && (last == chars.size() - 1))) {
+            return null;
+        }
+
+        return chars.subList(first, last + 1);
+    }
+
