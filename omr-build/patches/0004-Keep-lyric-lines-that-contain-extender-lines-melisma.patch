+    //-----------------//
+    // isExtensionLine //
+    //-----------------//
+    /**
+     * Check whether the provided one-char dash word is an extender line rather than a hyphen.
+     * <p>
+     * OCR reads both as '-', '_', en dash or em dash. But a hyphen lies around mid x-height,
+     * while an extender line lies on the baseline of the neighboring words.
+     *
+     * @param word the dash word
+     * @return true if word looks like an extender line
+     */
+    private static boolean isExtensionLine (TextWord word)
+    {
+        final Rectangle box = word.getBounds();
+
+        if ((box == null) || (word.getSheet() == null) || (word.getSheet().getScale() == null)) {
+            return false;
+        }
+
+        final Scale scale = word.getSheet().getScale();
+
+        // Baseline of nearest words with letters or digits, on left and on right
+        TextWord left = null;
+        TextWord right = null;
+
+        if (word.getTextLine() != null) {
+            final double xMid = box.getCenterX();
+
+            for (TextWord w : word.getTextLine().getWords()) {
+                if ((w == word) || (w.getBaseline() == null) || (w.getBounds() == null)
+                        || w.getValue().codePoints().noneMatch(Character::isLetterOrDigit)) {
+                    continue;
+                }
+
+                final Rectangle wb = w.getBounds();
+
+                if (wb.getCenterX() < xMid) {
+                    if ((left == null) || (wb.x > left.getBounds().x)) {
+                        left = w;
+                    }
+                } else if ((right == null) || (wb.x < right.getBounds().x)) {
+                    right = w;
+                }
+            }
+        }
+
+        final double baseY;
+
+        if ((left != null) || (right != null)) {
+            baseY = (left == null) ? right.getBaseline().getY1()
+                    : ((right == null) ? left.getBaseline().getY2()
+                            : (left.getBaseline().getY2() + right.getBaseline().getY1()) / 2);
+        } else {
+            // No text around, use dash own baseline but require some length
+            final Line2D base = word.getBaseline();
+
+            if ((base == null) || (box.width < scale.toPixels(constants.minExtensionWidth))) {
+                return false;
+            }
+
+            baseY = (base.getY1() + base.getY2()) / 2;
+        }
+
+        final double rise = baseY - (box.y + box.height - 1); // Height of dash bottom above base
+
+        return rise <= scale.toPixelsDouble(constants.maxExtensionRise);
+    }
+
+    //-----------------------//
+    // isFollowedByExtension //
+    //-----------------------//
+    /**
+     * Report whether this syllable is directly followed by an extension item in its line.
+     *
+     * @return true if so
+     */
+    private boolean isFollowedByExtension ()
+    {
+        if ((itemKind != LyricItemKind.Syllable) || (getEnsemble() == null)) {
+            return false;
+        }
+
+        final List<? extends Inter> items = getEnsemble().getMembers();
+        final int index = items.indexOf(this);
+
+        if ((index == -1) || (index == (items.size() - 1))) {
+            return false;
+        }
+
+        return (items.get(index + 1) instanceof LyricItemInter next)
+                && (next.itemKind == LyricItemKind.Extension);
+    }
+
