+    //-------------//
+    // isAlongLine //
+    //-------------//
+    /**
+     * Tell whether an arc is a piece of bare staff line: at least one interline long, and
+     * at least 4 of its points in 5 on a staff line with nothing else (see
+     * {@link #isBareLine(Point)}).
+     * <p>
+     * A curve may not go on along a staff line, even where its side is too flat for its bending
+     * direction to count.
+     *
+     * @param arc the arc
+     * @return true if so
+     */
+    private boolean isAlongLine (Arc arc)
+    {
+        final List<Point> points = arc.getPoints();
+
+        if (points.size() < params.minBareLength) {
+            return false;
+        }
+
+        int bare = 0;
+
+        for (Point p : points) {
+            if (isBareLine(p)) {
+                bare++;
+            }
+        }
+
+        return (5 * bare) >= (4 * points.size());
+    }
+
+    //------------//
+    // isBareLine //
+    //------------//
+    /**
+     * Tell whether this skeleton point lies on a staff line with nothing else: its vertical
+     * run holds the line and sticks out of it on neither side.
+     *
+     * @param p the skeleton point
+     * @return true if so
+     */
+    private boolean isBareLine (Point p)
+    {
+        final Run run = verticalRuns.getRunAt(p.x, p.y);
+        final Staff staff = (run != null) ? sheet.getStaffManager().getClosestStaff(p) : null;
+
+        if ((staff == null) || staff.isTablature()) {
+            return false;
+        }
+
+        final LineInfo line = staff.getClosestStaffLine(p);
+        final double ly = line.yAt((double) p.x);
+        final double half = line.getThickness() / 2;
+
+        return (ly >= run.getStart()) && (ly <= run.getStop())
+                       && (((ly - half) - run.getStart()) < params.minStickOut)
+                       && ((run.getStop() - (ly + half)) < params.minStickOut);
+    }
+
+    //--------//
+    // isFlat //
+    //--------//
+    /**
+     * Tell whether a side model bends too little over its side of the curve for its bending
+     * direction to mean anything.
+     * <p>
+     * The side of a long flat tie is nearly straight: the circle through three of its points
+     * bends either way by a fraction of a pixel, and a side that seems to bend against the slur
+     * stops the slur from reaching its end (Goodbye Yellow Brick Road's left-hand ties along the
+     * staff's top line, The Longest Time's under the bottom line).
+     *
+     * @param model the side model
+     * @param pts   the curve points the side model was computed on
+     * @return true if its sagitta over the side is at most maxFlatSagitta
+     */
+    private boolean isFlat (Model model,
+                            List<Point> pts)
+    {
+        if (!(model instanceof CircleModel circleModel)) {
+            return true;
+        }
+
+        final double r = circleModel.getCircle().getRadius();
+        final List<Point> side = reverse ? pts.subList(0, params.sideLength)
+                : pts.subList(pts.size() - params.sideLength, pts.size());
+        final double chord = side.get(0).distance(side.get(side.size() - 1));
+        final double sagitta = r - Math.sqrt(Math.max(0, (r * r) - ((chord * chord) / 4)));
+
+        return sagitta <= params.maxFlatSagitta;
+    }
+
+    //---------//
+    // onCurve //
+    //---------//
+    /**
+     * Report where a curve really passes at this skeleton point, when the point lies on a
+     * staff line the curve runs along.
+     * <p>
+     * The skeleton is computed on the image with its staff lines. Where a curve runs along a
+     * staff line close enough to merge with it (a long flat tie just above or below a staff,
+     * sagging along its outer line; a tie over a head in a space, along the line above), each
+     * vertical run holds both: the line, and the curve sticking out of it on one side. The
+     * skeleton point lies in the middle of the run, a pixel or two off the curve towards the
+     * line, and such a stretch is flatter than the curve: a side circle through it bends the
+     * wrong way, or misses the points beyond it. The curve's middle is half a line thickness
+     * inside the run's outer end.
+     *
+     * @param p the skeleton point
+     * @return p itself, or the point on the curve
+     */
+    private Point onCurve (Point p)
+    {
+        Point q = onCurvePoints.get(p);
+
+        if (q == null) {
+            q = p;
+
+            final Run run = verticalRuns.getRunAt(p.x, p.y);
+            final Staff staff = (run != null) ? sheet.getStaffManager().getClosestStaff(p) : null;
+
+            if ((staff != null) && !staff.isTablature()) {
+                final LineInfo line = staff.getClosestStaffLine(p);
+                final double ly = line.yAt((double) p.x);
+                final double half = line.getThickness() / 2;
+
+                if ((ly >= run.getStart()) && (ly <= run.getStop())) {
+                    final double above = (ly - half) - run.getStart();
+                    final double below = run.getStop() - (ly + half);
+
+                    if ((above >= params.minStickOut) && (below < params.minStickOut)) {
+                        q = new Point(p.x, (int) Math.round(run.getStart() + half));
+                    } else if ((below >= params.minStickOut) && (above < params.minStickOut)) {
+                        q = new Point(p.x, (int) Math.round(run.getStop() - half));
+                    }
+                }
+            }
+
+            onCurvePoints.put(new Point(p), q);
+        }
+
+        return q;
+    }
+
