+     * @return the absolute ordinate difference, or null if the head is not right at the end
+     */
+    private Double altDy (HorizontalSide side,
+                          HeadInter alt,
+                          Staff staff)
+    {
+        if (alt.getStaff() != staff) {
+            return null;
+        }
+
+        final double il = staff.getSpecificInterline();
+        final Point2D end = (side == LEFT) ? curve.getP1() : curve.getP2();
+
+        // Abscissa: the head lies just beyond the curve end
+        final Rectangle box = alt.getBounds();
+        final double dx = (side == RIGHT) ? box.x - end.getX() : end.getX() - (box.x + box.width);
+
+        if ((dx < -constants.maxTieAltOverlap.getValue() * il)
+                || (dx > constants.maxTieAltDx.getValue() * il)) {
+            return null;
+        }
+
+        // Ordinate: on the concave side of the curve, close to the curve end
+        final Point2D center = alt.getCenter2D();
+        final double dy = above ? (center.getY() - end.getY()) : (end.getY() - center.getY());
+
+        if ((dy < -constants.maxTieAltBeyond.getValue() * il)
+                || (dy > constants.maxTieAltDy.getValue() * il)) {
+            return null;
