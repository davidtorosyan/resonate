+    //------------------//
+    // checkOctaveClefs //
+    //------------------//
+    /**
+     * Turn a plain G or F clef into its octave variant when there is evidence of the little 8.
+     * <p>
+     * The classifier is weak on octave clefs (rare in training): on a bass clef with an 8 below,
+     * the plain F_CLEF on the clef part alone grades about 0.8, while F_CLEF_8VB on the whole
+     * clef + 8 glyph grades only 0.05 to 0.3, so a plain clef wins and the whole staff comes out
+     * an octave too high. But octave candidates appear only when that extra 8 is there: so if the
+     * classifier proposed the octave variant of the chosen clef for a glyph that extends past it
+     * (below for 8vb, above for 8va) by at least half an interline, we use that variant, with the
+     * grade of the plain clef (the clef itself is not in doubt).
+     *
+     * @param bestMap best clef per kind, modified in place
+     */
+    private void checkOctaveClefs (Map<ClefKind, ClefInter> bestMap)
+    {
+        for (Map.Entry<ClefKind, ClefInter> entry : bestMap.entrySet()) {
+            final ClefInter plain = entry.getValue();
+            final Shape[] variants = switch (plain.getShape()) {
+                case F_CLEF -> new Shape[] { F_CLEF_8VB, F_CLEF_8VA };
+                case G_CLEF -> new Shape[] { G_CLEF_8VB, G_CLEF_8VA };
+                default -> new Shape[0];
+            };
+
+            for (Shape variant : variants) {
+                final ClefInter octave = octaveCandidates.get(variant);
+
+                if ((octave == null) || (octave.getGlyph() == null)) {
+                    continue;
+                }
+
+                final Rectangle pb = plain.getBounds();
+                final Rectangle ob = octave.getBounds();
+                final boolean below = (variant == F_CLEF_8VB) || (variant == G_CLEF_8VB);
+                final int extension = below ? (ob.y + ob.height) - (pb.y + pb.height) : pb.y - ob.y;
+                final int xMid = pb.x + (pb.width / 2);
+
+                if ((extension >= params.minOctaveExtension) && (ob.x <= xMid)
+                        && ((ob.x + ob.width) >= xMid)) {
+                    final ClefInter inter = ClefInter.createValid(
+                            octave.getGlyph(),
+                            variant,
+                            plain.getGrade(),
+                            staff);
+
+                    if (inter != null) {
+                        logger.info(
+                                "Staff#{} {} with an 8 {} (octave candidate grade {})",
+                                staff.getId(),
+                                variant,
+                                below ? "below" : "above",
+                                String.format("%.2f", octave.getGrade()));
+                        entry.setValue(inter);
+
+                        break;
+                    }
+                }
+            }
+        }
+    }
+
