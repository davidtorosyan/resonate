 .../omr/sheet/symbol/DotFactory.java          | 65 +++++++++++++++++--
 1 file changed, 58 insertions(+), 7 deletions(-)

diff --git a/app/src/main/java/org/audiveris/omr/sheet/symbol/DotFactory.java b/app/src/main/java/org/audiveris/omr/sheet/symbol/DotFactory.java
index 876b7f0a8..51a3d2757 100644
--- a/app/src/main/java/org/audiveris/omr/sheet/symbol/DotFactory.java
+++ b/app/src/main/java/org/audiveris/omr/sheet/symbol/DotFactory.java
@@ -105,7 +105,7 @@ public class DotFactory
 
     private final SIGraph sig;
 
-    /** Dot candidates. Sorted top down, then left to right. */
+    /** Dot candidates. For late checks: by columns left to right, each column top down. */
     private final List<Dot> dots = new ArrayList<>();
 
     //~ Constructors -------------------------------------------------------------------------------
@@ -597,7 +597,7 @@ public class DotFactory
      */
     public void lateDotChecks ()
     {
-        Collections.sort(dots, Dot.byAbscissa);
+        sortDots();
 
         // Run all late checks
         lateAugmentationChecks(); // Note-Dot and Note-Dot-Dot configurations
@@ -660,6 +660,49 @@ public class DotFactory
         checkStackRepeats();
     }
 
+    //----------//
+    // sortDots //
+    //----------//
+    /**
+     * Sort the dot candidates for the late checks: left to right by columns, a column being
+     * the dots whose abscissa range overlaps the one of its leftmost dot, each column top down.
+     * <p>
+     * The augmentation dots of a chord are stacked in one column, and
+     * {@link AugmentationDotInter#lookupHeadLink} expects them top down: a dot between two heads on
+     * lines takes the upper head while it is free, and the dot below goes to the lower head.
+     * Sorted by abscissa only, a column kept the order in which its glyphs had been evaluated, that
+     * of a hash set of glyphs (the glyph cluster), which changes from run to run: bottom up, the
+     * lower dot of a third on lines took the upper head, the upper dot found no free head, and the
+     * chord, with one head of two dotted, lost its dot.
+     * <p>
+     * Both orders are total (abscissa, ordinate, width, height), so that the result no longer
+     * depends on the order in which the dots were found.
+     */
+    private void sortDots ()
+    {
+        Collections.sort(dots, Dot.byAbscissa);
+
+        final List<Dot> sorted = new ArrayList<>(dots.size());
+
+        for (int i = 0; i < dots.size();) {
+            final Rectangle first = dots.get(i).getBounds();
+            final int xMax = first.x + first.width; // Exclusive
+            int j = i + 1;
+
+            while ((j < dots.size()) && (dots.get(j).getBounds().x < xMax)) {
+                j++;
+            }
+
+            final List<Dot> column = new ArrayList<>(dots.subList(i, j));
+            Collections.sort(column, Dot.byOrdinate);
+            sorted.addAll(column);
+            i = j;
+        }
+
+        dots.clear();
+        dots.addAll(sorted);
+    }
+
     //~ Inner Classes ------------------------------------------------------------------------------
 
     //-----------//
@@ -682,12 +725,20 @@ public class DotFactory
     private abstract static class Dot
     {
         /**
-         * Sorting dots by left abscissa.
+         * Sorting dots by left abscissa, then top ordinate, width, height.
+         */
+        public static final Comparator<Dot> byAbscissa = Comparator.comparingInt(
+                (Dot d) -> d.getBounds().x).thenComparingInt(d -> d.getBounds().y)
+                .thenComparingInt(d -> d.getBounds().width).thenComparingInt(
+                        d -> d.getBounds().height);
+
+        /**
+         * Sorting dots by top ordinate, then left abscissa, width, height.
          */
-        public static final Comparator<Dot> byAbscissa = (Dot d1,
-                                                          Dot d2) -> {
-            return Integer.compare(d1.getBounds().x, d2.getBounds().x);
-        };
+        public static final Comparator<Dot> byOrdinate = Comparator.comparingInt(
+                (Dot d) -> d.getBounds().y).thenComparingInt(d -> d.getBounds().x)
+                .thenComparingInt(d -> d.getBounds().width).thenComparingInt(
+                        d -> d.getBounds().height);
 
         public abstract int getAnnotationId ();
 
