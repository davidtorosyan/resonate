+    //-------------//
+    // sheetFailed //
+    //-------------//
+    /**
+     * Report the processing failure of a sheet, in a stable one-line format
+     * ("Sheet#N failed at STEP: reason"), and in batch discard the sheet so that the book can
+     * still be transcribed from its other sheets.
+     *
+     * @param stub the failed sheet stub
+     * @param ex   the exception (or error) raised
+     * @return true if no other sheet should be processed: the music font is unusable, memory
+     *         is exhausted, or an error was raised on the calling thread
+     */
+    private boolean sheetFailed (SheetStub stub,
+                                 Throwable ex)
+    {
+        Throwable cause = ex;
+
+        for (Throwable t = ex; t != null; t = t.getCause()) {
+            if ((t instanceof MusicFont.UnusableFontException) || (t instanceof OutOfMemoryError)) {
+                cause = t;
+                break;
+            }
+        }
+
+        // Skip the exceptions that merely wrap another one (executors, system tasks, timeout)
+        while ((cause.getCause() != null) && ((cause instanceof ExecutionException)
+                || Objects.equals(cause.getMessage(), cause.getCause().toString()))) {
+            cause = cause.getCause();
+        }
+
+        final String reason;
+
+        if (cause instanceof TimeoutException) {
+            reason = "timeout after " + Main.getSheetStepTimeOut() + " seconds";
+        } else if (((cause instanceof StepException)
+                || (cause instanceof MusicFont.UnusableFontException))
+                && (cause.getMessage() != null)) {
+            reason = cause.getMessage();
+        } else {
+            reason = cause.toString();
+        }
+
+        final OmrStep step = stub.getFailedStep();
+        logger.warn(
+                "Sheet#{} failed at {}: {}",
+                stub.getNumber(),
+                (step != null) ? step : "?",
+                reason.replaceAll("\\s+", " ").trim());
+
+        if (OMR.gui == null) {
+            stub.discard();
+        }
+
+        return (ex instanceof Error) || (cause instanceof MusicFont.UnusableFontException)
+                || (cause instanceof OutOfMemoryError);
+    }
